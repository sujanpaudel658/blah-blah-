{
  "name": "hotel-management",
  "version": "1.0.0",
  "description": "Hotel Management System",
  "scripts": {
    "prestart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/xampp-mysql.ps1 start",
    "start": "concurrently -n api,ui -c cyan,magenta \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "install-all": "cd backend && npm install && cd ../frontend && npm install",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/xampp-mysql.ps1 status",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/xampp-mysql.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/xampp-mysql.ps1 stop",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/xampp-mysql.ps1 backup"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}